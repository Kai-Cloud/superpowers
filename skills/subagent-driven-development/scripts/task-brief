#!/usr/bin/env bash
# Extract one numbered task, validating before creating or replacing artifacts.
set -euo pipefail
if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo 'usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]' >&2; exit 2
fi
plan=$1
n=$2
[[ "$n" =~ ^[1-9][0-9]*$ ]] || { echo 'invalid task number' >&2; exit 2; }
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }
text=$(awk -v n="$n" '
  /^```/ { infence = !infence }
  !infence && /^#+[ \t]+Task[ \t]+[0-9]+/ {
    intask = ($0 ~ ("^#+[ \t]+Task[ \t]+" n "([^0-9]|$)"))
  }
  intask { print }
' "$plan")
[ -n "$text" ] || { echo "task $n not found in $plan" >&2; exit 3; }
source "$(cd "$(dirname "$0")" && pwd)/sdd-workspace"
sp_resolve "$plan"
if [ $# = 3 ]; then out=$3
else
  dir=$(bash "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-$n-brief.md"
fi
printf '%s\n' "$text" > "$out"
printf 'wrote %s: %s lines\n' "$out" "$(wc -l < "$out" | tr -d ' ')"
